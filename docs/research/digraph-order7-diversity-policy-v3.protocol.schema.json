{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://partizan.dev/schemas/digraph-order7-diversity-policy-v3.protocol.schema.json",
  "title": "Partizan Digraph Placement diversity policy V3 protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "freeze_date",
    "preregistration_path",
    "repair_scope",
    "source_evidence",
    "domain",
    "initialization",
    "arms",
    "models",
    "structural_filter",
    "acquisition",
    "splits",
    "budget",
    "validation_gate",
    "primary_analysis",
    "pareto_restoration_gate",
    "integrity",
    "resource_gate",
    "failure_policy",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "partizan.digraph_order7_diversity_policy_protocol.v3"
    },
    "status": {
      "const": "DESIGN_FROZEN_VALIDATION_AND_TEST_DATA_NOT_GENERATED"
    },
    "freeze_date": {
      "const": "2026-07-27"
    },
    "preregistration_path": {
      "const": "docs/research/DIGRAPH_ORDER7_DIVERSITY_POLICY_V3_PREREGISTRATION.md"
    },
    "repair_scope": {
      "type": "object"
    },
    "source_evidence": {
      "type": "object"
    },
    "domain": {
      "type": "object"
    },
    "initialization": {
      "type": "object"
    },
    "arms": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object"
      }
    },
    "models": {
      "type": "object"
    },
    "structural_filter": {
      "type": "object"
    },
    "acquisition": {
      "type": "object"
    },
    "splits": {
      "type": "object",
      "required": ["validation", "test"],
      "additionalProperties": false,
      "properties": {
        "validation": {
          "$ref": "#/$defs/split"
        },
        "test": {
          "$ref": "#/$defs/split"
        }
      }
    },
    "budget": {
      "type": "object"
    },
    "validation_gate": {
      "type": "object"
    },
    "primary_analysis": {
      "type": "object"
    },
    "pareto_restoration_gate": {
      "type": "object"
    },
    "integrity": {
      "type": "object"
    },
    "resource_gate": {
      "type": "object"
    },
    "failure_policy": {
      "type": "object"
    },
    "claim_boundary": {
      "type": "object"
    }
  },
  "$defs": {
    "split": {
      "type": "object",
      "required": [
        "pair_count_per_target",
        "verifier_calls_per_arm_pair",
        "pair_seeds",
        "initialization_indices"
      ],
      "properties": {
        "pair_count_per_target": {
          "type": "integer",
          "minimum": 1
        },
        "verifier_calls_per_arm_pair": {
          "type": "integer",
          "minimum": 1
        },
        "pair_seeds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "initialization_indices": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        }
      }
    }
  }
}
